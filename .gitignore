# Data: raw archive and extracted/derived data are not versioned (large; reproducible from the archive)
*.zip
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Keep the small split metadata so the frozen split is verifiable from git
!data/processed/splits/
data/processed/splits/*
!data/processed/splits/split_metadata.json

# Large model artifacts (later phases)
artifacts/**/*.pt
artifacts/**/*.bin
artifacts/**/*.npy
artifacts/**/*.joblib

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
.vscode/

# Frozen cluster centroids are small (18 KB) and are the source of truth (refits are not bit-reproducible)
!artifacts/phase4/cluster_model/centroids.npy

# Phase 6: the frozen meta-model bundle is small and versioned; OOF base scores are reproducible (crossfit_base.py)
!artifacts/phase6/meta_model.joblib
artifacts/phase6/train_oof_base.csv

# Phase 10: version the small decision-path weights so a fresh clone can run the final system and demo
!artifacts/phase3/sbert_all-MiniLM-L6-v2/mlp.pt
!artifacts/phase3/sbert_all-MiniLM-L6-v2/lr.joblib
!artifacts/phase2/lr_lexical.joblib
